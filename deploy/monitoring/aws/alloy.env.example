# /home/ubuntu/gwangsan-telemetry/alloy.env (권한 600). 비밀 값은 넣지 않는다.
TEMPO_TUNNEL_ENDPOINT=http://172.22.0.1:14318
PROMETHEUS_TUNNEL_ENDPOINT=http://172.22.0.1:19090
DEPLOYMENT_ENVIRONMENT=production

# 비워 두면 해당 대상을 만들지 않는다(대시보드에는 '미수집').
# API: management.server.port=9091, 앱이 gwangsan-observability 네트워크에 연결된 뒤 활성화.
API_METRICS_TARGET=gwangsan-api:9091
# 채팅: 내부 전용 9464 포트.
CHAT_METRICS_TARGET=gwangsan-chat:9464
# 호스트 node_exporter는 Docker gateway에만 바인딩(exporters/node-exporter-run.sh).
NODE_EXPORTER_TARGET=172.22.0.1:9100
# Promtail을 gwangsan-observability 네트워크에 연결한 뒤 활성화.
PROMTAIL_METRICS_TARGET=

# db-redis.alloy를 둘 때만 사용.
REDIS_EXPORTER_ADDR=redis://<redis-사설IP>:6379
REDIS_EXPORTER_USER=gwangsan-monitor
MARIADB_NODE_TARGET=
REDIS_NODE_TARGET=
