{
  "uid": "gwangsan-overview",
  "title": "00 · 서비스 현황",
  "description": "광산 운영 관제 홈. 장애 서비스를 찾고 상세 화면으로 이동한다.",
  "tags": [
    "gwangsan"
  ],
  "timezone": "Asia/Seoul",
  "weekStart": "monday",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "graphTooltip": 1,
  "editable": false,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "gwangsan"
      ],
      "asDropdown": true,
      "title": "광산 운영 관제",
      "keepTime": true,
      "includeVars": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "앱 재시작(배포 추정)",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "expr": "changes(process_start_time_seconds{service=~\"gwangsan-api|gwangsan-chat\",environment=~\"$environment\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "{{service}} 재시작",
        "textFormat": "프로세스 시작 시각 변경"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "query": {
          "query": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
          "refId": "env"
        },
        "definition": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "API 요청/초",
      "description": "정의: API가 처리 완료한 HTTP 요청 수의 초당 비율\n출처: Spring Micrometer http_server_requests\n단위: 건/초\n집계 창: $__rate_interval\n결측 처리: API 지표가 없으면 '미수집'. 0은 실제 요청 없음\n이상 시 확인: 01 · API 요청·외부 연동",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"gwangsan-api\",environment=~\"$environment\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:건/초",
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "미수집",
                  "color": "#8E8E8E",
                  "index": 9
                }
              }
            }
          ],
          "decimals": 2,
          "links": [
            {
              "title": "API 상세",
              "url": "/d/gwangsan-api?${__url_time_range}&${environment:queryparam}",
              "oneClick": true
            }
          ]
        },
        "overrides": []
      },
      "links": [],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "API 5xx",
      "description": "정의: 5분 동안 5xx 응답 / 전체 응답\n출처: http_server_requests_seconds_count{status}\n단위: 비율(%)\n집계 창: 5분\n결측 처리: 요청이 0건이면 계산하지 않음(요청 없음 또는 미수집)\n이상 시 확인: 01 · API, 07 · 로그",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"gwangsan-api\",environment=~\"$environment\",status=~\"5..\"}[5m])) / (sum(rate(http_server_requests_seconds_count{service=\"gwangsan-api\",environment=~\"$environment\"}[5m])) > 0)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "요청 없음·미수집",
          "thresholds": {
