              {
                "color": "green",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
