    {
      "type": "stat",
      "title": "CPU 사용률",
      "description": "정의: 호스트별 idle 제외 CPU\n출처: node_exporter\n단위: %\n집계 창: 5분\n결측 처리: exporter 미설치 호스트는 표시 없음\n이상 시 확인: CPU 추세",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{instance=~\"$host\",mode=\"idle\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
