      "title": "힙·비힙 메모리",
      "description": "정의: 영역별 사용·커밋·최대 메모리\n출처: jvm_memory_*_bytes\n단위: 바이트\n집계 창: scrape 15초\n결측 처리: -\n이상 시 확인: GC 추세",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{service=\"gwangsan-api\",environment=~\"$environment\"})",
          "refId": "A",
          "legendFormat": "사용 {{area}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum by (area) (jvm_memory_committed_bytes{service=\"gwangsan-api\",environment=~\"$environment\"})",
          "refId": "B",
          "legendFormat": "커밋 {{area}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{service=\"gwangsan-api\",environment=~\"$environment\",area=\"heap\"} > 0)",
          "refId": "C",
          "legendFormat": "최대 heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "미수집",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(API|gwangsan-api).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(채팅|gwangsan-chat).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#14B8A6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(Redis|redis).*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A352CC"
                }
              }
            ]
          }
        ]
      },
      "links": [],
