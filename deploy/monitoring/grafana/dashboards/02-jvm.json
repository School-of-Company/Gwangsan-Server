    {
      "type": "stat",
      "title": "힙 사용률",
      "description": "정의: 힙 사용량 / 최대 힙\n출처: jvm_memory_used_bytes·max_bytes{area=heap}\n단위: %\n집계 창: 현재값\n결측 처리: 최대값 미정(-1) 풀은 제외\n이상 시 확인: 힙·비힙 추세",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{service=\"gwangsan-api\",environment=~\"$environment\",area=\"heap\"}) / sum(jvm_memory_max_bytes{service=\"gwangsan-api\",environment=~\"$environment\",area=\"heap\"} > 0)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "미수집",
                  "color": "#8E8E8E",
                  "index": 9
                }
              }
            }
          ],
          "decimals": 1
        },
        "overrides": []
      },
