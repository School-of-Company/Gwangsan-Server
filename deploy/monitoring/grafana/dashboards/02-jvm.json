        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "expr": "changes(process_start_time_seconds{service=~\"gwangsan-api|gwangsan-chat\",environment=~\"$environment\"}[2m]) > 0",
