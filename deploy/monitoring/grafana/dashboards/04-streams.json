{
  "uid": "gwangsan-streams",
  "title": "04 · Redis Streams 처리",
  "description": "채팅 저장 파이프라인: 발행 → 소비 → DB 커밋 → ACK, 재시도·DLQ, 집계 상태.",
  "tags": [
    "gwangsan"
  ],
  "timezone": "Asia/Seoul",
  "weekStart": "monday",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "graphTooltip": 1,
  "editable": false,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "gwangsan"
      ],
      "asDropdown": true,
      "title": "광산 운영 관제",
      "keepTime": true,
      "includeVars": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "앱 재시작(배포 추정)",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "expr": "changes(process_start_time_seconds{service=~\"gwangsan-api|gwangsan-chat\",environment=~\"$environment\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "{{service}} 재시작",
        "textFormat": "프로세스 시작 시각 변경"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "query": {
          "query": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
          "refId": "env"
        },
        "definition": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "group",
        "label": "스트림 범위",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "query": {
          "query": "label_values(gwangsan_stream_pending{environment=~\"$environment\"}, group)",
          "refId": "group"
        },
        "definition": "label_values(gwangsan_stream_pending{environment=~\"$environment\"}, group)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "읽기 전 대기",
      "description": "정의: 아직 소비자에게 전달되지 않은 메시지(lag)\n출처: gwangsan_stream_unread\n단위: 건\n집계 창: 30초 캐시\n결측 처리: lag null·부분 집계 → 계산 불가(0 아님)\n이상 시 확인: 그룹별 추세",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum(gwangsan_stream_unread{environment=~\"$environment\",group=~\"$group\"}) and on() (min(gwangsan_stream_snapshot_complete{environment=~\"$environment\",group=~\"$group\"}) == 1)",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:건",
          "noValue": "계산 불가",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "계산 불가",
                  "color": "#8E8E8E",
                  "index": 9
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "links": [],
