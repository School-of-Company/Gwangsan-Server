        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "query": {
          "query": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
          "refId": "env"
        },
        "definition": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
