{
  "uid": "gwangsan-api",
  "title": "01 · API 요청·외부 연동",
  "description": "Spring API 처리량·오류·지연, 외부 호출, 관련 로그·트레이스.",
  "tags": [
    "gwangsan"
  ],
  "timezone": "Asia/Seoul",
  "weekStart": "monday",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "graphTooltip": 1,
  "editable": false,
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "gwangsan"
      ],
      "asDropdown": true,
      "title": "광산 운영 관제",
      "keepTime": true,
      "includeVars": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "앱 재시작(배포 추정)",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "expr": "changes(process_start_time_seconds{service=~\"gwangsan-api|gwangsan-chat\",environment=~\"$environment\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "{{service}} 재시작",
        "textFormat": "프로세스 시작 시각 변경"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "query": {
          "query": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
          "refId": "env"
        },
        "definition": "label_values(up{collector=\"gwangsan-aws-alloy\"}, environment)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "uri",
        "label": "경로 템플릿",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gwangsan-prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count{service=\"gwangsan-api\",environment=~\"$environment\"}, uri)",
          "refId": "uri"
        },
        "definition": "label_values(http_server_requests_seconds_count{service=\"gwangsan-api\",environment=~\"$environment\"}, uri)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "처리량",
      "description": "정의: 완료된 HTTP 요청/초\n출처: http_server_requests_seconds_count\n단위: 건/초\n집계 창: $__rate_interval\n결측 처리: 미수집과 0(요청 없음)을 구분\n이상 시 확인: 아래 상태 코드 분포",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"gwangsan-api\",environment=~\"$environment\",uri=~\"$uri\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:건/초",
          "noValue": "미수집",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "미수집",
                  "color": "#8E8E8E",
                  "index": 9
                }
              }
            }
          ],
          "decimals": 2
        },
        "overrides": []
      },
      "links": [],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
