    {
      "type": "timeseries",
      "title": "응답 시간 백분위",
      "description": "정의: 경로 필터 적용 후 합산 히스토그램 백분위\n출처: http_server_requests_seconds_bucket\n단위: 초\n집계 창: 5분\n결측 처리: 표본이 적으면 p99는 해석 제한\n이상 시 확인: 느린 경로 순위, 07 · 트레이스",
      "datasource": {
        "type": "prometheus",
        "uid": "gwangsan-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"gwangsan-api\",environment=~\"$environment\",uri=~\"$uri\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"gwangsan-api\",environment=~\"$environment\",uri=~\"$uri\"}[5m])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gwangsan-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"gwangsan-api\",environment=~\"$environment\",uri=~\"$uri\"}[5m])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "미수집",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "insertNulls": false,
            "stacking": {
